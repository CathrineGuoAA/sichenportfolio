{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/navigation/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnotatedWord'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|key|ref|className|style|children)$/]",
        "message": "<AnnotatedWord> doesn't accept that prop. Declared props: children, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|direction|href|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: children, direction, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:down|right|up)$/]",
        "message": "<ArrowLink> direction must be one of 'down' | 'right' | 'up'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|year|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: name, year."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|links|activeIndex|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: name, links, activeIndex."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|alt|caption|bg|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: image, alt, caption, bg."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "AnnotatedWord": {
        "replaces": []
      },
      "ArrowLink": {
        "replaces": []
      },
      "Footer": {
        "replaces": []
      },
      "NavBar": {
        "replaces": []
      },
      "ProjectCard": {
        "replaces": []
      }
    },
    "tokens": [
      "--accent",
      "--accent-ink",
      "--bg-card",
      "--bg-page",
      "--border-default",
      "--border-strong",
      "--content-max",
      "--font-display",
      "--font-mono",
      "--font-sans",
      "--fs-body",
      "--fs-caption",
      "--fs-h1",
      "--fs-h2",
      "--fs-lede",
      "--fs-nav",
      "--fs-small",
      "--fw-medium",
      "--fw-regular",
      "--fw-semibold",
      "--ink-1",
      "--ink-2",
      "--ink-3",
      "--lh-body",
      "--lh-lede",
      "--lh-tight",
      "--line-1",
      "--line-2",
      "--link-color",
      "--link-hover",
      "--page-margin",
      "--radius-md",
      "--radius-sm",
      "--space-1",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--space-8",
      "--space-9",
      "--surface-card",
      "--surface-invert",
      "--surface-page",
      "--text-body",
      "--text-caption",
      "--text-heading",
      "--text-muted",
      "--tracking-tight",
      "--white"
    ],
    "tokenKinds": {
      "--white": "color",
      "--ink-1": "color",
      "--ink-2": "color",
      "--ink-3": "color",
      "--line-1": "color",
      "--line-2": "color",
      "--bg-page": "color",
      "--bg-card": "color",
      "--accent": "color",
      "--accent-ink": "color",
      "--text-heading": "font",
      "--text-body": "font",
      "--text-muted": "font",
      "--text-caption": "font",
      "--surface-page": "color",
      "--surface-card": "color",
      "--surface-invert": "color",
      "--border-default": "color",
      "--border-strong": "color",
      "--link-color": "color",
      "--link-hover": "color",
      "--font-sans": "font",
      "--font-display": "font",
      "--font-mono": "font",
      "--fs-nav": "spacing",
      "--fs-caption": "spacing",
      "--fs-small": "spacing",
      "--fs-body": "spacing",
      "--fs-lede": "spacing",
      "--fs-h2": "spacing",
      "--fs-h1": "spacing",
      "--lh-tight": "other",
      "--lh-body": "other",
      "--lh-lede": "other",
      "--fw-regular": "other",
      "--fw-medium": "other",
      "--fw-semibold": "other",
      "--tracking-tight": "font",
      "--space-1": "spacing",
      "--space-2": "spacing",
      "--space-3": "spacing",
      "--space-4": "spacing",
      "--space-5": "spacing",
      "--space-6": "spacing",
